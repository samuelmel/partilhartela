LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
SERVER_PORT=8787
VITE_TOKEN_SERVER_URL=http://localhost:8787
# Opcional (desktop): URL pública do viewer web; "Copiar" passa a gerar link ?room=CODIGO.
VITE_WEB_APP_URL=
# Opcional (web): destino do botão "Baixar para Windows". Padrão: GitHub Releases (latest).
VITE_DOWNLOAD_URL=

# ---------- Integração com o Discord ----------
# apps/server/.env
# URL pública do servidor; o botão do bot aponta para PUBLIC_BASE_URL/join/CODIGO (use https em produção).
PUBLIC_BASE_URL=http://localhost:8787
# OAuth2 do app no Discord Developer Portal (login "Entrar com Discord" no desktop). Secret nunca vai ao cliente.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Segredo compartilhado entre servidor e bot (rotas /internal). Gere um valor longo e aleatório.
BOT_API_SECRET=
# Opcional: arquivo SQLite (salas, sessões, voice states). Padrão: data/partilhartela.db no cwd do server.
DATABASE_PATH=
# Opcional: link "Baixar" e "Assistir no navegador" da página /join.
DOWNLOAD_URL=
WEB_APP_URL=

# apps/bot/.env (o token do bot fica só no servidor que roda o bot)
DISCORD_BOT_TOKEN=
# URL do servidor de tokens vista pelo bot e o mesmo BOT_API_SECRET de cima.
BACKEND_URL=http://localhost:8787
# Opcional: registra /tela só neste servidor do Discord (aparece na hora; bom para testes).
DISCORD_DEV_GUILD_ID=
