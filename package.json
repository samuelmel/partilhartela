{
  "name": "partilhartela",
  "version": "2.0.4",
  "private": true,
  "description": "Compartilhamento de tela e áudio ao vivo com Tauri, React e LiveKit",
  "workspaces": [
    "apps/server",
    "apps/bot",
    "apps/web",
    "apps/desktop-tauri"
  ],
  "scripts": {
    "dev": "npm run dev:tauri",
    "dev:server": "npm --workspace apps/server run dev",
    "build": "npm run build:server && npm run build:bot",
    "build:server": "npm --workspace apps/server run build",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck": "npm run typecheck:server && npm run typecheck:bot && npm run typecheck:tauri",
    "typecheck:server": "npm --workspace apps/server run typecheck",
    "typecheck:tauri": "npm --workspace apps/desktop-tauri run typecheck",
    "dev:tauri": "npm --workspace apps/desktop-tauri run tauri:dev",
    "build:tauri": "npm --workspace apps/desktop-tauri run tauri:build",
    "test:e2e:web": "node scripts/e2e-web.mjs",
    "dev:bot": "npm --workspace apps/bot run dev",
    "build:bot": "npm --workspace apps/bot run build",
    "typecheck:bot": "npm --workspace apps/bot run typecheck"
  }
}
