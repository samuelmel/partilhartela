{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartilharTela",
  "version": "2.0.0",
  "identifier": "com.partilhartela.tauri",
  "build": {
    "beforeDevCommand": "npm run dev:webview",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build:webview",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PartilharTela",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.discordapp.com; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "partilhartela"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMjJCMUU4RDJCNjVFRTkKUldUcFhyYlM2TEVpdXlWcDBqUVduWGVua1VwS1Z4U01naXdpYnNWRm9HZGplTGFtVUZKNEhrOTkK",
      "endpoints": [
        "https://github.com/samuelmel/partilhartela/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}